<div class="product-carousel section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-carousel__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="product-carousel__viewport">
    <div class="page-width product-carousel__inner">
      <div class="product-carousel__track" data-carousel-track>
        {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            <div class="product-carousel__item">
              {% render 'product-card-carousel', product: product, badge_label: section.settings.badge_label %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..5) -%}
            <div class="product-carousel__item">
              {% render 'product-card-placeholder' %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button type="button" class="product-carousel__arrow product-carousel__arrow--prev" data-carousel-prev aria-label="Previous">
        {% render 'icon-arrow-right' %}
      </button>
      <button type="button" class="product-carousel__arrow product-carousel__arrow--next" data-carousel-next aria-label="Next">
        {% render 'icon-arrow-right' %}
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "NEW"
    }
  ],
  "presets": [
    {
      "name": "Product carousel"
    }
  ]
}
{% endschema %}

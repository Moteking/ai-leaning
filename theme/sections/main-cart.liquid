<div class="cart-page section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    <h1 class="cart-page__title">{{ 'general.cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-form">
        <div class="cart-table" role="table">
          <div class="cart-table__head" role="row">
            <div role="columnheader">Product</div>
            <div role="columnheader">{{ 'general.cart.quantity' | t }}</div>
            <div role="columnheader">Price</div>
          </div>
          {%- for item in cart.items -%}
            <div class="cart-table__row" role="row" data-line-item-id="{{ item.key }}">
              <div class="cart-table__product" role="cell">
                <a href="{{ item.url }}" class="cart-table__image-link">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag:
                      loading: 'lazy',
                      width: 100,
                      height: 100,
                      alt: item.title
                    }}
                  {%- endif -%}
                </a>
                <div class="cart-table__meta">
                  <a href="{{ item.url }}" class="cart-table__title">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cart-table__variant">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  {%- if item.sku != blank -%}
                    <p class="cart-table__sku">SKU: {{ item.sku }}</p>
                  {%- endif -%}
                </div>
              </div>

              <div class="cart-table__quantity" role="cell">
                <div class="quantity-input">
                  <button type="button" class="quantity-input__button" data-cart-quantity="decrease" data-line="{{ forloop.index }}">−</button>
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="quantity-input__input"
                    data-line="{{ forloop.index }}">
                  <button type="button" class="quantity-input__button" data-cart-quantity="increase" data-line="{{ forloop.index }}">+</button>
                </div>
                <a href="{{ item.url_to_remove }}" class="cart-table__remove">{{ 'general.cart.remove' | t }}</a>
              </div>

              <div class="cart-table__price" role="cell">
                {{ item.final_line_price | money }}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-footer">
          <div class="cart-footer__summary">
            <div class="cart-footer__row cart-footer__row--total">
              <span>{{ 'general.cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-footer__note">{{ 'general.cart.taxes_and_shipping_at_checkout' | t }}</p>
          </div>
          <div class="cart-footer__actions">
            <button type="submit" name="update" class="button button--secondary">{{ 'general.cart.update' | t }}</button>
            <button type="submit" name="checkout" class="button button--primary">{{ 'general.cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-page__empty">
        <p>{{ 'general.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
          {{ 'general.cart.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}

<div class="collection-page section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    <header class="collection-page__header">
      <h1 class="collection-page__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-page__description rte">{{ collection.description }}</div>
      {%- endif -%}
      <p class="collection-page__count">{{ 'products.facets.results_count' | t: count: collection.products_count }}</p>
    </header>

    <div class="collection-page__toolbar">
      <form class="collection-page__sort" method="get">
        <label for="SortBy" class="visually-hidden">{{ 'products.facets.sort_by' | t }}</label>
        <select id="SortBy" name="sort_by" onchange="this.form.submit()">
          {%- assign sort_options = 'manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-ascending,created-descending' | split: ',' -%}
          {%- for opt in sort_options -%}
            <option value="{{ opt }}"{% if collection.sort_by == opt or collection.default_sort_by == opt %} selected{% endif %}>
              {%- case opt -%}
                {%- when 'manual' -%}{{ 'collections.sorting.featured' | t }}
                {%- when 'best-selling' -%}{{ 'collections.sorting.best_selling' | t }}
                {%- when 'title-ascending' -%}{{ 'collections.sorting.az' | t }}
                {%- when 'title-descending' -%}{{ 'collections.sorting.za' | t }}
                {%- when 'price-ascending' -%}{{ 'collections.sorting.price_ascending' | t }}
                {%- when 'price-descending' -%}{{ 'collections.sorting.price_descending' | t }}
                {%- when 'created-ascending' -%}{{ 'collections.sorting.date_ascending' | t }}
                {%- when 'created-descending' -%}{{ 'collections.sorting.date_descending' | t }}
              {%- endcase -%}
            </option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid product-grid--4-col">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="pagination__link">{{ 'general.pagination.previous' | t }}</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
              {%- else -%}
                <span class="pagination__link pagination__link--current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="pagination__link">{{ 'general.pagination.next' | t }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="collection-page__empty">{{ 'collections.general.no_matches' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}

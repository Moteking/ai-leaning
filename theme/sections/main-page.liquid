<div class="page section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <header class="page__header">
      <h1 class="page__title">{{ page.title }}</h1>
    </header>
    <div class="page__content rte">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}

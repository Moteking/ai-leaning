<div class="ranking-products section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ranking-products__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="ranking-products__viewport">
    <div class="page-width">
      <div class="ranking-products__track" data-ranking-track>
        {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
          {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
            <a href="{{ product.url }}" class="ranking-card" data-rank="{{ forloop.index }}">
              <span class="ranking-card__number" aria-hidden="true">{{ forloop.index }}</span>
              <div class="ranking-card__media">
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 500 | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 500',
                    sizes: '(min-width: 990px) 14vw, 40vw',
                    class: 'ranking-card__image'
                  }}
                {%- else -%}
                  <div class="ranking-card__placeholder"></div>
                {%- endif -%}
              </div>
              <p class="ranking-card__title">{{ product.title }}</p>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..7) -%}
            <div class="ranking-card">
              <span class="ranking-card__number" aria-hidden="true">{{ i }}</span>
              <div class="ranking-card__media">
                <div class="ranking-card__placeholder"></div>
              </div>
              <p class="ranking-card__title">Product {{ i }}</p>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ranking products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Access Ranking"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 7
    }
  ],
  "presets": [
    {
      "name": "Ranking products"
    }
  ]
}
{% endschema %}

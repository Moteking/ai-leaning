<div class="announcement-bar" role="region" aria-label="Announcements">
  <div class="page-width announcement-bar__inner">
    {%- if section.settings.text != blank -%}
      <p class="announcement-bar__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $100"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}

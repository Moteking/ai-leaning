<header class="site-header{% if section.settings.enable_sticky_header %} site-header--sticky{% endif %}" data-section-id="{{ section.id }}">
  <div class="page-width site-header__inner">
    <button
      type="button"
      class="site-header__menu-toggle"
      aria-label="{{ 'general.accessibility.menu' | t }}"
      aria-expanded="false"
      data-menu-toggle>
      <span class="hamburger" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag:
          class: 'site-header__logo-image',
          widths: '100, 200, 300, 400',
          width: section.settings.logo_width,
          height: logo_height,
          alt: shop.name
        }}
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Main navigation" data-site-nav>
      <ul class="site-nav__list">
        {%- for link in section.settings.menu.links -%}
          <li class="site-nav__item{% if link.links != blank %} site-nav__item--has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="site-nav__link">
              {{ link.title }}
              {%- if link.links != blank -%}
                <span class="site-nav__caret" aria-hidden="true">▾</span>
              {%- endif -%}
            </a>
            {%- if link.links != blank -%}
              <div class="site-nav__dropdown">
                <div class="page-width">
                  <ul class="site-nav__sublist">
                    {%- for child in link.links -%}
                      <li class="site-nav__subitem">
                        <a href="{{ child.url }}" class="site-nav__sublink">{{ child.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button type="button" class="site-header__action" aria-label="{{ 'general.accessibility.search' | t }}" data-search-toggle>
        {% render 'icon-search' %}
      </button>
      <a href="{{ routes.account_url }}" class="site-header__action" aria-label="{{ 'general.accessibility.account' | t }}">
        {% render 'icon-account' %}
      </a>
      <a href="{{ routes.cart_url }}" class="site-header__action site-header__action--cart" aria-label="{{ 'general.accessibility.cart' | t }}" data-cart-link>
        {% render 'icon-cart' %}
        <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="site-search" data-search-panel hidden>
    <div class="page-width">
      <form action="{{ routes.search_url }}" method="get" role="search" class="site-search__form">
        <input
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          class="site-search__input"
          aria-label="{{ 'general.search.search' | t }}">
        <button type="submit" class="site-search__submit">{{ 'general.search.search' | t }}</button>
      </form>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Sticky header",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}

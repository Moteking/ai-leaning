<footer class="site-footer" role="contentinfo">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        {%- if section.settings.footer_logo != blank -%}
          {{ section.settings.footer_logo | image_url: width: 240 | image_tag:
            class: 'site-footer__logo',
            width: 120,
            alt: shop.name
          }}
        {%- else -%}
          <p class="site-footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      <div class="site-footer__blocks">
        {%- for block in section.blocks -%}
          <div class="site-footer__block site-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank -%}
                  <h4 class="site-footer__heading">{{ block.settings.heading }}</h4>
                {%- endif -%}
                {%- if block.settings.menu.links.size > 0 -%}
                  <ul class="site-footer__links">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h4 class="site-footer__heading">{{ block.settings.heading }}</h4>
                {%- endif -%}
                <div class="site-footer__text rte">{{ block.settings.text }}</div>

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h4 class="site-footer__heading">{{ block.settings.heading }}</h4>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="site-footer__subheading">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- form 'customer', class: 'newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="newsletter-form__inner">
                    <label class="visually-hidden" for="NewsletterEmail-{{ block.id }}">{{ 'general.newsletter.label' | t }}</label>
                    <input
                      type="email"
                      name="contact[email]"
                      id="NewsletterEmail-{{ block.id }}"
                      placeholder="{{ 'general.newsletter.placeholder' | t }}"
                      class="newsletter-form__input"
                      required>
                    <button type="submit" class="newsletter-form__button">
                      {{ 'general.newsletter.button' | t }}
                    </button>
                  </div>
                  {%- if form.posted_successfully? -%}
                    <p class="newsletter-form__message">{{ 'general.newsletter.success' | t }}</p>
                  {%- endif -%}
                {%- endform -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__social">
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener">Facebook</a>
        {%- endif -%}
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener">Instagram</a>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <a href="{{ settings.social_youtube_link }}" aria-label="YouTube" rel="noopener">YouTube</a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" aria-label="X" rel="noopener">X</a>
        {%- endif -%}
      </div>

      <div class="site-footer__legal">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
        {%- if section.settings.payment_enable -%}
          <div class="site-footer__payment-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'payment-icon' }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Premium timepieces for every moment."
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Sign up for exclusive updates."
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}

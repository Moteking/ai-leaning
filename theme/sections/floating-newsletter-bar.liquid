<div class="floating-newsletter-bar" data-floating-bar data-section-id="{{ section.id }}">
  <div class="page-width floating-newsletter-bar__inner">
    <div class="floating-newsletter-bar__text">
      {%- if section.settings.text != blank -%}
        <span class="floating-newsletter-bar__label">{{ section.settings.text }}</span>
      {%- endif -%}
    </div>
    <a href="{{ section.settings.button_link | default: '#' }}" class="floating-newsletter-bar__button">
      {{ section.settings.button_label }}
      <span aria-hidden="true">⌄</span>
    </a>
    <button type="button" class="floating-newsletter-bar__close" aria-label="Close" data-floating-bar-close>
      {% render 'icon-close' %}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Floating newsletter bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Floating newsletter bar"
    }
  ]
}
{% endschema %}

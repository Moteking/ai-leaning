<div class="hero-slider hero-slider--{{ section.settings.height }}" data-section-id="{{ section.id }}" data-hero-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval }}">
  <div class="hero-slider__track" data-slider-track>
    {%- for block in section.blocks -%}
      <div class="hero-slider__slide{% if forloop.first %} is-active{% endif %}" data-slider-slide {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="hero-slider__media">
            {{ block.settings.image | image_url: width: 2400 | image_tag:
              loading: forloop.first | conditional: 'eager', 'lazy',
              fetchpriority: forloop.first | conditional: 'high', 'auto',
              widths: '600, 900, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              class: 'hero-slider__image'
            }}
          </div>
        {%- endif -%}
        {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
          <div class="hero-slider__content hero-slider__content--{{ block.settings.text_position }}">
            <div class="page-width">
              {%- if block.settings.subheading != blank -%}
                <p class="hero-slider__subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="hero-slider__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="button button--primary hero-slider__button">{{ block.settings.button_label }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero-slider__pagination" data-slider-pagination>
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="hero-slider__dot{% if forloop.first %} is-active{% endif %}"
          data-slider-dot="{{ forloop.index0 }}"
          aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Slide interval (sec)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "middle-center", "label": "Middle center" }
          ],
          "default": "bottom-left"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

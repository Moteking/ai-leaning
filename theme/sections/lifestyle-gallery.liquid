<div class="lifestyle-gallery section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="lifestyle-gallery__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="lifestyle-gallery__list" style="--columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '#' }}" class="lifestyle-card" {{ block.shopify_attributes }}>
          <div class="lifestyle-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                widths: '200, 300, 400, 600',
                sizes: '(min-width: 990px) 20vw, 50vw',
                class: 'lifestyle-card__image'
              }}
            {%- else -%}
              <div class="lifestyle-card__placeholder"></div>
            {%- endif -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <p class="lifestyle-card__caption">{{ block.settings.caption }}</p>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lifestyle gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Staff Styling"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Lifestyle gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}

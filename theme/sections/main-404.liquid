<div class="page-404 section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <div class="page-404__inner">
      <p class="page-404__number">404</p>
      <h1 class="page-404__title">Page not found</h1>
      <p class="page-404__text">The page you were looking for could not be found.</p>
      <a href="{{ routes.root_url }}" class="button button--primary">Return to home</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}

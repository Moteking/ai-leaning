# ===== 本番(Vercel)で設定する環境変数 =====

# サービスの公開URL(sitemap / robots / OGP の絶対URL生成に使用)
# 例: https://ai-search-checker.kaaay.co.jp
NEXT_PUBLIC_SITE_URL=https://example.com

# 「専門家による無料相談」CTAのリンク先
NEXT_PUBLIC_CONSULT_CTA_URL=https://kaaay.co.jp

# リード保存先(優先順: FORM_PREFILL_URL → WEBHOOK_URL → ローカルSQLite)

# 【推奨・OAuth不要】Googleフォーム経由でスプレッドシートに保存
# Googleフォームの「事前入力したURLを取得」で、各設問に __COMPANY__ / __EMAIL__ /
# __URL__ / __SCORE__ / __GRADE__ のマーカーを入れて生成したURLをそのまま設定する
# LEADS_FORM_PREFILL_URL=https://docs.google.com/forms/d/e/XXXX/viewform?usp=pp_url&entry.111=__COMPANY__&entry.222=__EMAIL__&entry.333=__URL__&entry.444=__SCORE__&entry.555=__GRADE__

# 【別法】リード送信先のWebフックURL(Apps Script / Zapier / Make / CRM 等)
# LEADS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxx/exec

# Google Analytics 4 測定ID(設定された場合のみ計測タグを読み込む)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 「AI引用チェック」(/ai-mention) で使用する Anthropic APIキー(サーバー専用)
# 未設定の場合、AI引用チェックは「準備中」表示になります(他の機能は正常)。
# ANTHROPIC_API_KEY=sk-ant-...
# 使用モデル(任意・既定 claude-sonnet-4-6。Vercel無料枠の60秒に収めるため高速モデル)
# 品質重視で claude-opus-4-8 に変更可(検索が長引くと60秒超で失敗する場合あり)
# MENTION_MODEL=claude-sonnet-4-6

# ===== ローカル開発のみ =====
# リード保存用 SQLite ファイルのパス(未指定なら ./data/leads.db)
# LEADS_DB_PATH=/tmp/leads.db

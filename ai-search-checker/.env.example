# ===== 本番(Vercel)で設定する環境変数 =====

# サービスの公開URL(sitemap / robots / OGP の絶対URL生成に使用)
# 例: https://ai-search-checker.kaaay.co.jp
NEXT_PUBLIC_SITE_URL=https://example.com

# 「専門家による無料相談」CTAのリンク先
NEXT_PUBLIC_CONSULT_CTA_URL=https://kaaay.co.jp

# リード送信先のWebフックURL(設定するとサーバーレスでも永続化される)
# Google スプレッドシート(Apps Script)/ Zapier / Make / CRM 等のエンドポイント
# 未設定の場合はローカルSQLite(開発用)に保存される
# LEADS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxx/exec

# Google Analytics 4 測定ID(設定された場合のみ計測タグを読み込む)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===== ローカル開発のみ =====
# リード保存用 SQLite ファイルのパス(未指定なら ./data/leads.db)
# LEADS_DB_PATH=/tmp/leads.db

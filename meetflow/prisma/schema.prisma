// MeetFlow Prisma schema
// pgvector extension required on Neon/Supabase.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ===== Enums =====

enum Role {
  CANDIDATE
  COMPANY_ADMIN
  HIRING_MANAGER
  PLATFORM_ADMIN
}

enum WorkStyle {
  REMOTE
  HYBRID
  ONSITE
  FLEXIBLE
}

enum CompanySize {
  STARTUP
  SMB
  MID_MARKET
  ENTERPRISE
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum MatchStatus {
  PENDING
  APPROVED
  REJECTED_BY_AUDIT
  SCHEDULED
  EXPIRED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Plan {
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

// ===== Models =====

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  role             Role
  clerkId          String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  candidateProfile CandidateProfile?
  hiringManager    HiringManager?
  companyAdmins    CompanyAdmin[]
}

model CandidateProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  currentPosition   String?
  yearsOfExperience Int?
  skills            String[]
  desiredRoles      String[]
  desiredSalaryMin  Int?
  desiredSalaryMax  Int?
  workStyle         WorkStyle          @default(FLEXIBLE)
  cultureAnswers    Json?
  resumeText        String?
  // Embedding column managed via raw SQL migration (pgvector). Prisma does not
  // have first-class vector support, so we expose it as Unsupported.
  embedding         Unsupported("vector(1536)")?
  // [COMPLIANCE] Consent timestamp for personal data usage. Required by the
  // Employment Security Act and the Personal Information Protection Act.
  consentedAt       DateTime
  availabilitySlots AvailabilitySlot[]
  matches           Match[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Company {
  id             String          @id @default(cuid())
  name           String
  description    String
  industry       String
  size           CompanySize
  websiteUrl     String?
  logoUrl        String?
  admins         CompanyAdmin[]
  jobPostings    JobPosting[]
  subscription   Subscription?
  hiringManagers HiringManager[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model CompanyAdmin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model JobPosting {
  id             String                       @id @default(cuid())
  companyId      String
  company        Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  description    String
  requiredSkills String[]
  salaryMin      Int
  salaryMax      Int
  workStyle      WorkStyle
  status         JobStatus                    @default(ACTIVE)
  embedding      Unsupported("vector(1536)")?
  matches        Match[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
}

model HiringManager {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId               String
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  displayName             String
  position                String
  googleCalendarConnected Boolean            @default(false)
  availabilitySlots       AvailabilitySlot[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model AvailabilitySlot {
  id                 String            @id @default(cuid())
  startsAt           DateTime
  endsAt             DateTime
  candidateProfileId String?
  candidateProfile   CandidateProfile? @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  hiringManagerId    String?
  hiringManager      HiringManager?    @relation(fields: [hiringManagerId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())

  @@index([startsAt, endsAt])
}

model Match {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  jobPostingId       String
  jobPosting         JobPosting       @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  fitScore           Float
  // [COMPLIANCE] Reasoning retained for audit by the job-placement officer.
  // Must be kept for at least 5 years.
  fitReasonJson      Json
  status             MatchStatus      @default(PENDING)
  auditedBy          String?
  auditedAt          DateTime?
  meeting            Meeting?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([candidateProfileId, jobPostingId])
}

model Meeting {
  id                    String        @id @default(cuid())
  matchId               String        @unique
  match                 Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scheduledAt           DateTime
  duration              Int
  meetingUrl            String
  briefingForCandidate  String
  briefingForCompany    String
  status                MeetingStatus @default(SCHEDULED)
  feedbacks             Feedback[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Feedback {
  id           String   @id @default(cuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  fromUserId   String
  rating       Int
  comment      String?
  wantNextStep Boolean
  createdAt    DateTime @default(now())
}

model Subscription {
  id                    String             @id @default(cuid())
  companyId             String             @unique
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                  Plan
  stripeSubscriptionId  String             @unique
  monthlyMeetingQuota   Int
  meetingsUsedThisMonth Int                @default(0)
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd      DateTime
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

// [COMPLIANCE] Immutable audit log. Records every sensitive action so the
// job-placement officer can answer regulator inquiries.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

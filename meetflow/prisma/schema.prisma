// MeetFlow Prisma schema (B2B HR-Tech, post-pivot).
// The hiring company uploads applicants' résumés, attaches a personality
// diagnostic, and lets AI score how well each applicant fits the company.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====

enum Role {
  COMPANY_ADMIN
  HIRING_MANAGER
  PLATFORM_ADMIN
}

enum WorkStyle {
  REMOTE
  HYBRID
  ONSITE
  FLEXIBLE
}

enum CompanySize {
  STARTUP
  SMB
  MID_MARKET
  ENTERPRISE
}

enum JobStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TemplateOrigin {
  STANDARD
  CUSTOM
}

enum QuestionType {
  SINGLE_CHOICE
  LIKERT
  FREE_TEXT
}

enum ApplicationStatus {
  AWAITING_DIAGNOSTIC
  SUBMITTED
  REVIEWED
  HIRED
  REJECTED
}

// ===== Models =====

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  role          Role
  clerkId       String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  hiringManager HiringManager?
  companyAdmins CompanyAdmin[]
}

model Company {
  id             String               @id @default(cuid())
  name           String
  description    String
  industry       String
  size           CompanySize
  websiteUrl     String?
  logoUrl        String?
  // Free-form description of who thrives at this company. Fed to the AI scorer
  // to anchor culture fit. Editable from the company settings screen.
  cultureProfile String?
  admins         CompanyAdmin[]
  jobOpenings    JobOpening[]
  hiringManagers HiringManager[]
  invites        Invite[]
  templates      DiagnosticTemplate[]
  applicants     Applicant[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model CompanyAdmin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model HiringManager {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  displayName String
  position    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Invitation token used to onboard hiring managers into a company.
model Invite {
  id         String    @id @default(cuid())
  token      String    @unique
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email      String
  role       Role
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId])
  @@index([email])
}

model JobOpening {
  id               String              @id @default(cuid())
  companyId        String
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  description      String
  requiredSkills   String[]
  niceToHaveSkills String[]
  salaryMin        Int
  salaryMax        Int
  workStyle        WorkStyle
  status           JobStatus           @default(ACTIVE)
  // Optional template attached to the job. If null, scorer falls back to the
  // company's default (most-recent CUSTOM, or none).
  templateId       String?
  template         DiagnosticTemplate? @relation(fields: [templateId], references: [id])
  applicants       Applicant[]
  applications     Application[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model DiagnosticTemplate {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  origin      TemplateOrigin
  // Optional per-question rubric in the shape:
  //   { questionId: { idealValue?, weight?, rationale? } }
  // The scorer uses this to know which answers the company prefers.
  rubric      Json?
  questions   DiagnosticQuestion[]
  jobOpenings JobOpening[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model DiagnosticQuestion {
  id         String               @id @default(cuid())
  templateId String
  template   DiagnosticTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order      Int
  prompt     String
  type       QuestionType
  // Shape: [{ value: string, label: string }] for SINGLE_CHOICE; [{ value: 1..5, label: string }]
  // for LIKERT; null for FREE_TEXT.
  options    Json?
  responses  DiagnosticResponse[]

  @@index([templateId, order])
}

// Person who applied to a specific opening. Not a Clerk user — they access
// the diagnostic via a single-use link backed by `diagnosticToken`.
model Applicant {
  id                       String       @id @default(cuid())
  companyId                String
  company                  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobOpeningId             String
  jobOpening               JobOpening   @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  fullName                 String
  email                    String
  // Plain-text résumé. PDF parsing comes in a later phase.
  resumeText               String
  diagnosticToken          String       @unique
  diagnosticTokenExpiresAt DateTime
  application              Application?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([companyId, createdAt])
  @@index([email])
}

model Application {
  id                    String               @id @default(cuid())
  applicantId           String               @unique
  applicant             Applicant            @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobOpeningId          String
  jobOpening            JobOpening           @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  status                ApplicationStatus    @default(AWAITING_DIAGNOSTIC)
  diagnosticSubmittedAt DateTime?
  // AI scoring output. Populated by the scorer after diagnostic submission.
  fitScore              Float?
  fitReasonJson         Json?
  evaluatedAt           DateTime?
  responses             DiagnosticResponse[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([jobOpeningId, status])
  @@index([fitScore])
}

model DiagnosticResponse {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // For SINGLE_CHOICE: option value. LIKERT: "1"-"5". FREE_TEXT: free string.
  value         String

  @@unique([applicationId, questionId])
}

// Append-only audit log. Useful for ops, not legally required (we are no
// longer operating as a placement service post-pivot).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
